{
  "name": "generate-project-kanban",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "module": "src/index.tsx",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "bun build src/index.tsx --compile --outfile dist/generate-project-kanban",
    "release:check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@setemiojo/eslint-config": "^9.5.1",
    "@types/bun": "1.3.14",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^5.9.3"
  }
}
